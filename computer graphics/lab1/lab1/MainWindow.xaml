<Window x:Class="lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конвертер: CMYK ↔ RGB ↔ HLS (Вариант 6)" Height="450" Width="850"
        MinHeight="400" MinWidth="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка для предупреждений об обрезании/округлении значений -->
        <TextBlock x:Name="TxtWarning" Grid.Row="0" Text="Предупреждение: значения были скорректированы (выход за границы диапазона)." 
                   Foreground="DarkOrange" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,0,0,10"/>

        <!-- Основной контент: 3 модели для 6 варианта -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Модель 1: CMYK -->
            <GroupBox Header="Модель CMYK" Grid.Column="0" Margin="5" Padding="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="C (Голубой, %):"/>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderC" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtC" Grid.Column="1" Text="{Binding ElementName=SliderC, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="M (Пурпурный, %):"/>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderM" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtM" Grid.Column="1" Text="{Binding ElementName=SliderM, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Y (Желтый, %):"/>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderY" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtY" Grid.Column="1" Text="{Binding ElementName=SliderY, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="K (Черный, %):"/>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderK" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtK" Grid.Column="1" Text="{Binding ElementName=SliderK, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Модель 2: RGB -->
            <GroupBox Header="Модель RGB" Grid.Column="1" Margin="5" Padding="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="R (Красный, 0-255):"/>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderR" Minimum="0" Maximum="255" Value="255" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtR" Grid.Column="1" Text="{Binding ElementName=SliderR, Path=Value, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="G (Зеленый, 0-255):"/>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderG" Minimum="0" Maximum="255" Value="255" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtG" Grid.Column="1" Text="{Binding ElementName=SliderG, Path=Value, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="B (Синий, 0-255):"/>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderB" Minimum="0" Maximum="255" Value="255" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtB" Grid.Column="1" Text="{Binding ElementName=SliderB, Path=Value, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Модель 3: HLS -->
            <GroupBox Header="Модель HLS" Grid.Column="2" Margin="5" Padding="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="H (Тон, 0-360°):"/>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderH" Minimum="0" Maximum="360" Value="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtH" Grid.Column="1" Text="{Binding ElementName=SliderH, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="L (Светлота, 0-100%):"/>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderL" Minimum="0" Maximum="100" Value="50" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtL" Grid.Column="1" Text="{Binding ElementName=SliderL, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="S (Насыщенность, 0-100%):"/>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderS" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtS" Grid.Column="1" Text="{Binding ElementName=SliderS, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Нижняя панель: визуализация и палитра -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ColorPreviewBorder" Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Height="40" Margin="0,0,10,0">
                <TextBlock Text="Текущий цвет" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="Black"/>
            </Border>

            <Button x:Name="BtnOpenPalette" Grid.Column="1" Content="Выбрать из палитры..." Width="140" Height="40"/>
        </Grid>
    </Grid>
</Window>
