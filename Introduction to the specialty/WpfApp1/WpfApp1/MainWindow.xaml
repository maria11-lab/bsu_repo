<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Hellow, World!" Height="450" Width="800">
    <Grid x:Name="TextBox3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="51*"/>
            <ColumnDefinition Width="349*"/>
        </Grid.ColumnDefinitions>
        <Label 
    Grid.Column="1" 
    Content="КАЛЬКУЛЯТОР" 
    HorizontalAlignment="Left" 
    Margin="208,71,0,0" 
    VerticalAlignment="Top"
    FontSize="24"/>
        <TextBox x:Name="textBox1" Grid.Column="1" HorizontalAlignment="Left" Margin="118,155,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <TextBox x:Name="textBox4" Grid.Column="1" HorizontalAlignment="Left" Margin="238,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="41"/>
        <TextBox x:Name="textBox2" Grid.Column="1" HorizontalAlignment="Left" Margin="357,155,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Grid.Column="1" Content="Первое число:" HorizontalAlignment="Left" Margin="118,129,0,0" VerticalAlignment="Top"/>
        <Label Grid.Column="1" Content="Результат:" HorizontalAlignment="Left" Margin="238,171,0,0" VerticalAlignment="Top"/>
        <Label Grid.Column="1" Content="Второе число:" HorizontalAlignment="Left" Margin="357,129,0,0" VerticalAlignment="Top"/>
        <Button Grid.Column="1" Content="*" HorizontalAlignment="Left" Margin="238,307,0,0" VerticalAlignment="Top" Width="48" Click="Button_Click_2"/>
        <Button Grid.Column="1" Content="+" HorizontalAlignment="Left" Margin="238,274,0,0" VerticalAlignment="Top" Width="48" Click="Button_Click"/>
        <Button Grid.Column="1" Content="-" HorizontalAlignment="Left" Margin="318,274,0,0" VerticalAlignment="Top" Width="48" Click="Button_Click_1"/>
        <Button Grid.Column="1" Content="/" HorizontalAlignment="Left" Margin="318,307,0,0" VerticalAlignment="Top" Width="48" Click="Button_Click_3"/>
        <GridSplitter HorizontalAlignment="Left" Height="100" Margin="-92,71,0,0" VerticalAlignment="Top" Width="6"/>
    </Grid>
</Window>
