<Window x:Class="ImageInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация об изображениях" Width="1200" Height="680" MinWidth="800" MinHeight="450"
        AllowDrop="True" Drop="Window_Drop" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <Border Grid.Row="0" Background="#F3F3F3" Padding="10,8" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnFolder" Content="📁 Выбрать папку…" Padding="14,6" Margin="0,0,8,0" Click="Choose_Click" />
                <Button x:Name="BtnStop" Content="⏹ Стоп" Padding="14,6" Margin="0,0,16,0" IsEnabled="False" Click="Stop_Click" />
                <CheckBox x:Name="ChkSub" Content="Включая подпапки" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Text="Фильтр по имени:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="FilterBox" Width="180" VerticalContentAlignment="Center" TextChanged="Filter_Changed" />
            </StackPanel>
        </Border>

        <!-- Таблица + предпросмотр -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="340" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="Table" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column" BorderThickness="0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                      EnableRowVirtualization="True" SelectionChanged="Table_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Имя файла" Binding="{Binding Name}" Width="240" />
                    <DataGridTextColumn Header="Формат" Binding="{Binding Format}" Width="80" />
                    <DataGridTextColumn Header="Размер, px" Binding="{Binding Size}" Width="110" />
                    <DataGridTextColumn Header="Разрешение, dpi" Binding="{Binding Dpi}" Width="120" />
                    <DataGridTextColumn Header="Глубина цвета" Binding="{Binding Depth}" Width="110" />
                    <DataGridTextColumn Header="Сжатие" Binding="{Binding Compression}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E4E4E4" />

            <!-- Окно предпросмотра -->
            <Border Grid.Column="2" Margin="8" BorderBrush="#DDDDDD" BorderThickness="1" Background="#FAFAFA">
                <Grid>
                    <Image x:Name="Preview" Stretch="Uniform" Margin="6"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="PreviewNote" Text="Выберите файл в таблице" Foreground="Gray"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="10" />
                </Grid>
            </Border>
        </Grid>

        <!-- Строка состояния -->
        <Border Grid.Row="2" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <ProgressBar x:Name="Bar" Width="260" Height="16" Margin="0,0,12,0" />
                <TextBlock x:Name="Status" Text="Перетащите папку в окно или нажмите «Выбрать папку…»" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>